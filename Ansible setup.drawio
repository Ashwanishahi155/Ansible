        <mxCell id="afyTzrGn9s4vOxVSszG1-161" value="Private key → Control Node par rahegi 🔐&#xa;Public key  → Managed VMs par jayegi 🔑" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
