        </mxCell>
        <mxCell id="afyTzrGn9s4vOxVSszG1-200" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;For Connectivity Test : ansible webservers -i inventory.ini -m ansible.builtin.ping&lt;/font&gt;&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1ba1e2;fontColor=#ffffff;strokeColor=#006EAF;" parent="1" vertex="1">
          <mxGeometry x="878.13" y="3390" width="481.87" height="60" as="geometry" />
        </mxCell>
        <UserObject label="---&#xa;# YAML document start&#xa;&#xa;&#xa;- name: Install Nginx on all web servers&#xa;  # Play ka naam&#xa;&#xa;&#xa;  hosts: webservers&#xa;  # Inventory ke [webservers] group ke sabhi VMs ko target karega&#xa;&#xa;&#xa;  become: yes&#xa;  # Tasks sudo/root privilege se execute honge&#xa;&#xa;&#xa;  tasks:&#xa;  # Yahan se tasks ki list start hoti hai&#xa;&#xa;&#xa;    - name: Update apt cache&#xa;      # APT package list update karne ka task&#xa;&#xa;&#xa;      ansible.builtin.apt:&#xa;        # Ubuntu/Debian package management ke liye APT module&#xa;&#xa;&#xa;        update_cache: yes&#xa;        # apt update run karega&#xa;&#xa;&#xa;        cache_valid_time: 3600&#xa;        # 3600 seconds (1 hour) tak fresh cache ho to dobara update nahi karega&#xa;&#xa;&#xa;    - name: Install Nginx&#xa;      # Nginx install karne ka task&#xa;&#xa;&#xa;      ansible.builtin.apt:&#xa;        # APT module use karega&#xa;&#xa;&#xa;        name: nginx&#xa;        # nginx package ko target karega&#xa;&#xa;&#xa;        state: present&#xa;        # Ensure karega ki Nginx installed hai&#xa;&#xa;&#xa;    - name: Start Nginx&#xa;      # Nginx service start karne ka task&#xa;&#xa;&#xa;      ansible.builtin.service:&#xa;        # Linux service manage karne ke liye service module&#xa;&#xa;&#xa;        name: nginx&#xa;        # nginx service ko target karega&#xa;&#xa;&#xa;        state: started&#xa;        # Ensure karega ki Nginx running hai&#xa;&#xa;&#xa;    - name: Enable Nginx at boot&#xa;      # Boot ke time Nginx automatically start karne ka task&#xa;&#xa;&#xa;      ansible.builtin.service:&#xa;        # Service management ke liye service module&#xa;&#xa;&#xa;        name: nginx&#xa;        # nginx service ko target karega&#xa;&#xa;&#xa;        enabled: yes&#xa;        # VM reboot ke baad Nginx automatically start hoga" link="---&#xa;# YAML document start&#xa;&#xa;&#xa;- name: Install Nginx on all web servers&#xa;  # Play ka naam&#xa;&#xa;&#xa;  hosts: webservers&#xa;  # Inventory ke [webservers] group ke sabhi VMs ko target karega&#xa;&#xa;&#xa;  become: yes&#xa;  # Tasks sudo/root privilege se execute honge&#xa;&#xa;&#xa;  tasks:&#xa;  # Yahan se tasks ki list start hoti hai&#xa;&#xa;&#xa;    - name: Update apt cache&#xa;      # APT package list update karne ka task&#xa;&#xa;&#xa;      ansible.builtin.apt:&#xa;        # Ubuntu/Debian package management ke liye APT module&#xa;&#xa;&#xa;        update_cache: yes&#xa;        # apt update run karega&#xa;&#xa;&#xa;        cache_valid_time: 3600&#xa;        # 3600 seconds (1 hour) tak fresh cache ho to dobara update nahi karega&#xa;&#xa;&#xa;    - name: Install Nginx&#xa;      # Nginx install karne ka task&#xa;&#xa;&#xa;      ansible.builtin.apt:&#xa;        # APT module use karega&#xa;&#xa;&#xa;        name: nginx&#xa;        # nginx package ko target karega&#xa;&#xa;&#xa;        state: present&#xa;        # Ensure karega ki Nginx installed hai&#xa;&#xa;&#xa;    - name: Start Nginx&#xa;      # Nginx service start karne ka task&#xa;&#xa;&#xa;      ansible.builtin.service:&#xa;        # Linux service manage karne ke liye service module&#xa;&#xa;&#xa;        name: nginx&#xa;        # nginx service ko target karega&#xa;&#xa;&#xa;        state: started&#xa;        # Ensure karega ki Nginx running hai&#xa;&#xa;&#xa;    - name: Enable Nginx at boot&#xa;      # Boot ke time Nginx automatically start karne ka task&#xa;&#xa;&#xa;      ansible.builtin.service:&#xa;        # Service management ke liye service module&#xa;&#xa;&#xa;        name: nginx&#xa;        # nginx service ko target karega&#xa;&#xa;&#xa;        enabled: yes&#xa;        # VM reboot ke baad Nginx automatically start hoga" id="afyTzrGn9s4vOxVSszG1-201">
