        <mxCell id="afyTzrGn9s4vOxVSszG1-154" value="─────────────────────────────────────────────┐&#xa;│ IDEMPOTENCY                                 │&#xa;│ Same playbook dobara → unnecessary change  │&#xa;│ nahi                                        │&#xa;└─────────────────────────────────────────────┘" style="text;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#36393d;" parent="1" vertex="1">
