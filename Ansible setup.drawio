        <mxCell id="afyTzrGn9s4vOxVSszG1-202" value="&lt;h3 data-section-id=&quot;1ek1im4&quot; dir=&quot;auto&quot; data-start=&quot;1611&quot; data-end=&quot;1646&quot; class=&quot;PDq2pG_selectionAnchorContainer&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;🔥 Isko yaad rakhne ka shortcut&lt;span aria-hidden=&quot;true&quot; class=&quot;PDq2pG_selectionAnchor&quot; style=&quot;&quot;&gt;&lt;/span&gt;&lt;/font&gt;&lt;/h3&gt;&lt;font style=&quot;&quot; size=&quot;3&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;1648&quot; data-end=&quot;1862&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-(--code-block-surface) corner-superellipse/1.1 overflow-clip rounded-3xl [--code-block-surface:var(--bg-elevated-secondary)] dark:[--code-block-surface:var(--composer-surface-primary)] lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;&lt;font style=&quot;&quot; size=&quot;3&quot;&gt;&lt;b&gt;hosts     → KAHAN?&lt;br&gt;become    → KIS privilege se?&lt;br&gt;tasks     → KYA-KYA karna hai?&lt;br&gt;apt       → PACKAGE manage&lt;br&gt;service   → SERVICE manage&lt;br&gt;present   → INSTALLED&lt;br&gt;started   → RUNNING&lt;br&gt;enabled   → BOOT par START&lt;/b&gt;&lt;/font&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;" style="text;whiteSpace=wrap;html=1;fillColor=#f0a30a;fontColor=#000000;strokeColor=#BD7000;" parent="1" vertex="1">
