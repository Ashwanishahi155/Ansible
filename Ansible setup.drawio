        <mxCell id="afyTzrGn9s4vOxVSszG1-176" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;jo cmd ka Output aaya use ek file me paste karenge&amp;nbsp;&lt;br&gt;nano vm-list.txt enter&amp;nbsp;&lt;br&gt;yaha detail pastr&amp;nbsp;&lt;br&gt;&amp;amp;&lt;br&gt;ctrl+o,enter,ctrl+x&lt;/font&gt;&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;gradientColor=#97d077;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="130" y="2240" width="400" height="90" as="geometry" />
