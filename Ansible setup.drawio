        <mxCell id="afyTzrGn9s4vOxVSszG1-191" value="&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;for Host&amp;nbsp; : ansible webservers -i inventory.ini --list-hosts&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;color: rgba(0, 0, 0, 0); font-family: monospace; font-size: 0px; text-align: start; text-wrap-mode: nowrap;&quot;&gt;%3CmxGraphModel%3E%3Croot%3E%3CmxCell%20id%3D%220%22%2F%3E%3CmxCell%20id%3D%221%22%20parent%3D%220%22%2F%3E%3CmxCell%20id%3D%222%22%20value%3D%22%26lt%3Bb%26gt%3B%26lt%3Bfont%20style%3D%26quot%3Bfont-size%3A%2014px%3B%26quot%3B%26gt%3Bfor%20Syntax%20structure%20%3A%20ansible-inventory%20%26lt%3Bspan%20class%3D%26quot%3B%CD%BCn%26quot%3B%26gt%3B-i%26lt%3B%2Fspan%26gt%3B%20inventory.ini%20%26lt%3Bspan%20class%3D%26quot%3B%CD%BCn%26quot%3B%26gt%3B--graph%26lt%3B%2Fspan%26gt%3B%26lt%3B%2Ffont%26gt%3B%26lt%3B%2Fb%26gt%3B%22%20style%3D%22text%3Bhtml%3D1%3BwhiteSpace%3Dwrap%3BstrokeColor%3D%23b85450%3BfillColor%3D%23f8cecc%3Balign%3Dcenter%3BverticalAlign%3Dmiddle%3Brounded%3D0%3BgradientColor%3D%23ea6b66%3B%22%20vertex%3D%221%22%20parent%3D%221%22%3E%3CmxGeometry%20x%3D%22878.13%22%20y%3D%223210%22%20width%3D%22471.87%22%20height%3D%2230%22%20as%3D%22geometry%22%2F%3E%3C%2FmxCell%3E%3C%2Froot%3E%3C%2FmxGraphModel%3E&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=#b85450;fillColor=#f8cecc;align=center;verticalAlign=middle;rounded=0;gradientColor=#ea6b66;" parent="1" vertex="1">
          <mxGeometry x="878.13" y="3275" width="481.87" height="30" as="geometry" />
