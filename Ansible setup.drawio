        <mxCell id="afyTzrGn9s4vOxVSszG1-162" value="&lt;b&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;STEPS&lt;/font&gt;&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffff88;strokeColor=#36393d;" parent="1" vertex="1">
