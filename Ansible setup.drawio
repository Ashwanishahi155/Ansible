        <mxCell id="afyTzrGn9s4vOxVSszG1-183" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Now Inventory.ini file banayege means Kis server pe karna ha&amp;nbsp;&lt;/font&gt;&lt;/b&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;yaha 2 kaam karna hoga&amp;nbsp;&lt;br&gt;1st [web server ke andaar Managed node ki ip &amp;amp; user name de denge&amp;nbsp;&lt;br&gt;&amp;amp;&amp;nbsp;&lt;br&gt;2nd - [webserver:var] me key path de denge&amp;nbsp;&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fad7ac;strokeColor=#b46504;" parent="1" vertex="1">
          <mxGeometry x="140" y="2890" width="620" height="260" as="geometry" />
        </mxCell>
        <mxCell id="afyTzrGn9s4vOxVSszG1-199" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;flowAnimation=1;" parent="1" source="afyTzrGn9s4vOxVSszG1-185" target="afyTzrGn9s4vOxVSszG1-198" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="afyTzrGn9s4vOxVSszG1-185" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b style=&quot;&quot;&gt;50 vm hai to manual IP &amp;amp; USERname type karnna difficult so use CMD&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font size=&quot;3&quot; style=&quot;&quot;&gt;&lt;b&gt;awk &#39;{printf &quot;managed%02d ansible_host=%s ansible_user=%s\n&quot;, NR, $1, $2}&#39; vm-list.txt&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;3&quot; style=&quot;&quot;&gt;&lt;b&gt;or&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;&quot; size=&quot;3&quot;&gt;&lt;b&gt;awk &#39;{printf &quot;managed%02d ansible_host = %s\n&quot; , NR ,$1,$2}&#39; vm-list.txt&lt;br&gt;&lt;br&gt;jo output aayega use Inventory.ini ke andar [webServers] ke andar paste kar denge&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;&quot; size=&quot;3&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font size=&quot;3&quot;&gt;2nd : [webservers:var] ke andar key cmd line kih denge&amp;nbsp;&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font size=&quot;3&quot;&gt;ansible_ssh_private_key_file=/home/azureuser/.ssh/id_ed25519&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffcd28;gradientColor=#ffa500;strokeColor=#d79b00;" parent="1" vertex="1">
          <mxGeometry x="120" y="3210" width="700" height="180" as="geometry" />
        </mxCell>
        <mxCell id="afyTzrGn9s4vOxVSszG1-188" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Inventory.ini ko 2 cheez chaiye&amp;nbsp;&lt;/font&gt;&lt;/b&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;1st- kin users se SSH Connect karna hai&amp;nbsp;&lt;/font&gt;&lt;/b&gt;&lt;div&gt;&lt;b&gt;&lt;font size=&quot;3&quot;&gt;2- kaun si authentication/key use karni hai&amp;nbsp;&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;gradientColor=#ffd966;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="450" y="2800" width="370" height="60" as="geometry" />
        </mxCell>
        <mxCell id="afyTzrGn9s4vOxVSszG1-190" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;for Syntax structure : ansible-inventory &lt;span class=&quot;ͼn&quot;&gt;-i&lt;/span&gt; inventory.ini &lt;span class=&quot;ͼn&quot;&gt;--graph&lt;/span&gt;&lt;/font&gt;&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=#b85450;fillColor=#f8cecc;align=center;verticalAlign=middle;rounded=0;gradientColor=#ea6b66;" parent="1" vertex="1">
