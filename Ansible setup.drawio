        <mxCell id="afyTzrGn9s4vOxVSszG1-166" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Ansible project banao - cmd : mkdir -p ~/ansible-lab&lt;br&gt;then CD karke ghus jaao&amp;nbsp;&lt;br&gt;&lt;br&gt;cd ~/ansible-lab&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#cdeb8b;strokeColor=#36393d;" parent="1" vertex="1">
          <mxGeometry x="118" y="1590" width="350" height="80" as="geometry" />
