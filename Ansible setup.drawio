        <mxCell id="afyTzrGn9s4vOxVSszG1-172" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;flowAnimation=1;" parent="1" source="afyTzrGn9s4vOxVSszG1-167" target="afyTzrGn9s4vOxVSszG1-168" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="afyTzrGn9s4vOxVSszG1-167" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;ab hume VM-list.txt file banai hai jiske andar VM IP &amp;amp; username dena hoga&amp;nbsp;&lt;/font&gt;&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;gradientColor=#7ea6e0;strokeColor=#6c8ebf;" parent="1" vertex="1">
          <mxGeometry x="92.13" y="1710" width="404" height="80" as="geometry" />
        </mxCell>
        <mxCell id="afyTzrGn9s4vOxVSszG1-175" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;flowAnimation=1;" parent="1" source="afyTzrGn9s4vOxVSszG1-168" target="afyTzrGn9s4vOxVSszG1-174" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="afyTzrGn9s4vOxVSszG1-168" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;power Shell pe&amp;nbsp;&lt;br&gt;&lt;br&gt;az login&amp;nbsp;&lt;/font&gt;&lt;/b&gt;&lt;div&gt;&lt;b&gt;&lt;font size=&quot;3&quot;&gt;&amp;nbsp;then&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font size=&quot;3&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;b&gt;&lt;font size=&quot;3&quot;&gt;az vm list -g ash-rg --query &quot;[].name&quot; -o tsv | ForEach-Object {&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font size=&quot;3&quot;&gt;&amp;nbsp; &amp;nbsp; $vm = $_&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font size=&quot;3&quot;&gt;&amp;nbsp; &amp;nbsp; $ip = az vm show -d -g ash-rg -n $vm --query &quot;publicIps&quot; -o tsv&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font size=&quot;3&quot;&gt;&amp;nbsp; &amp;nbsp; $user = az vm show -g ash-rg -n $vm --query &quot;osProfile.adminUsername&quot; -o tsv&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font size=&quot;3&quot;&gt;&amp;nbsp; &amp;nbsp; &quot;$ip $user&quot;&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font size=&quot;3&quot;&gt;}&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffcd28;gradientColor=#ffa500;strokeColor=#d79b00;" parent="1" vertex="1">
          <mxGeometry x="98.13" y="1830" width="840" height="230" as="geometry" />
        </mxCell>
        <mxCell id="afyTzrGn9s4vOxVSszG1-177" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;flowAnimation=1;" parent="1" source="afyTzrGn9s4vOxVSszG1-174" target="afyTzrGn9s4vOxVSszG1-176" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="afyTzrGn9s4vOxVSszG1-174" value="&lt;b&gt;Again Come on to Ansible-lab path&amp;nbsp;&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;gradientColor=#7ea6e0;strokeColor=#6c8ebf;" parent="1" vertex="1">
